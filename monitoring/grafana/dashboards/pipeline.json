{
  "title": "Retail Lakehouse | Releases and Quality",
  "uid": "learning-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "retail-lab",
    "observability"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "title": "Full workbook input",
      "description": "",
      "type": "stat",
      "datasource": null,
      "targets": [
        {
          "expr": "lab_input_rows{scope=\"full\",engine=\"lakehouse\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Accepted invoice lines",
      "description": "",
      "type": "stat",
      "datasource": null,
      "targets": [
        {
          "expr": "lab_accepted_rows{scope=\"full\",engine=\"lakehouse\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
