      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "mappings": [],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "title": "Quarantined lines",
      "description": "",
      "type": "stat",
      "datasource": null,
      "targets": [
        {
          "expr": "lab_quarantined_rows{scope=\"full\",engine=\"lakehouse\"}",
          "legendFormat": "",
          "refId": "A",
